[Unit]
Description=Standalone Model Serving Node Agent
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/model-serving
EnvironmentFile=/etc/model-serving-agent.env
ExecStart=/opt/model-serving/.venv/bin/python -m uvicorn node_agent:app --host 0.0.0.0 --port 9010
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/model-serving-agent /var/run/docker.sock /srv/model-serving

[Install]
WantedBy=multi-user.target
